# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Supabase Postgres (used by Prisma)
# Project Settings -> Database -> Connection string
# ---------------------------------------------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth / API
# Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
# Project Settings -> API -> JWT Settings -> JWT Secret (used to verify Auth tokens)
SUPABASE_JWT_SECRET="<jwt-secret>"

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage for media/icons)
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Account-scoped)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET="burmese-recipe-media"
# Public read URL for the bucket (r2.dev subdomain or a custom domain), no trailing slash.
R2_PUBLIC_BASE_URL="https://<public-bucket-domain>"
