# Values from Supabase Dashboard → Project Settings → API, or `supabase status` locally.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"

